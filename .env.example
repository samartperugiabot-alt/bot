# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
BASE_URL="https://your-app-name.onrender.com"
WEBHOOK_SECRET="A_VERY_SECRET_STRING_FOR_WEBHOOK_SECURITY"
ADMIN_CHAT_ID="YOUR_ADMIN_TELEGRAM_CHAT_ID"

# External API Keys
OWM_API_KEY="YOUR_OPENWEATHERMAP_API_KEY"
EXCHANGE_RATE_API_KEY="YOUR_EXCHANGERATE_API_KEY"
HUGGINGFACE_API_KEY="YOUR_HUGGINGFACE_INFERENCE_API_KEY" # Optional

# Google Services Credentials
# Base64 encoded JSON of your Google service account credentials
GOOGLE_CREDS_BASE64="YOUR_BASE64_ENCODED_GOOGLE_SERVICE_ACCOUNT_JSON"
GOOGLE_DRIVE_UPLOAD_FOLDER_ID="ID_OF_THE_FOLDER_IN_GOOGLE_DRIVE_FOR_UPLOADS"
SHEET_ID="YOUR_GOOGLE_SPREADSHEET_ID"
SPREADSHEET_NAME="YOUR_GOOGLE_SPREADSHEET_NAME" # e.g., "PerugiaBotDB"
QUESTIONS_SHEET_NAME="questions" # Name of the sheet for questions

# Redis (Upstash)
REDIS_URL="redis://default:password@host:port"

# Application Configuration
PORT="8000"
LOG_LEVEL="INFO"

# Optional: PostgreSQL Database (e.g., Neon)
# DATABASE_URL="postgresql://user:password@host:port/dbname"
